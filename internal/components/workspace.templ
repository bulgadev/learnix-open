package components

import (
	"learnix/internal/db"
	"learnix/internal/session"
)

templ Workspace(s *session.Session, files []db.File, chats []db.Chat, active *db.Chat, msgs []db.ChatMessage, user *db.User, q *db.Quota, isAdmin bool, state MobileStudyState) {
	@Layout(studyPageData("Estudar", "study", s.Config.Topic, user, q, isAdmin, s.StudyID, state)) {
		<div class="lg:-mb-24" style="width:100vw; margin-left:calc(50% - 50vw);" data-mobile-study-id={ idStr(s.StudyID) } data-mobile-pane={ state.Pane }
			x-data="workspaceMobile()" @mobile-pane.window="pane = $event.detail.pane">
			<div class="mobile-workspace-shell h-[calc(100dvh-var(--chrome-h,138px)-var(--mobile-nav-h))] min-h-0 flex flex-col lg:h-[calc(100vh-var(--chrome-h,138px))] lg:min-h-[560px]" x-data="workspaceLayout()">
				<div class="mobile-study-brand flex items-center gap-2 border-b border-line bg-ink/90 lg:hidden" :style="pane === 'chat' ? 'display:none' : ''">
					<button type="button" @click="pane = 'chat'" class="grid place-items-center w-9 h-9 rounded-none border border-line text-muted hover:text-lamp" aria-label="Voltar ao chat">
						<i data-lucide="arrow-left" class="w-4 h-4"></i>
					</button>
					<span class="grid place-items-center w-7 h-7 bg-lamp text-ink border border-ink">
						<i data-lucide="lamp-desk" class="w-3.5 h-3.5"></i>
					</span>
					<span class="mobile-study-topic flex-1 min-w-0 truncate font-700 text-cream">{ s.Config.Topic }</span>
				</div>

				<div class="hidden lg:flex items-center justify-between h-9 px-4 shrink-0">
					<div class="hidden md:flex items-center gap-2 text-[11px] text-muted/60">
						<i data-lucide="grip-vertical" class="w-3.5 h-3.5"></i>
						Arraste um painel pelo cabeçalho para reorganizar · arraste as divisórias para redimensionar
					</div>
					<div class="flex items-center gap-2">
						<a href={ studyBase(s.StudyID) + "/apps" }
							class="flex items-center gap-1.5 text-[11px] font-700 text-muted hover:text-lamp border border-line px-3 py-1.5 hover:border-lamp transition">
							<i data-lucide="blocks" class="w-3 h-3"></i>
							Apps interativos
						</a>
						<button type="button" @click="resetLayout()"
							class="flex items-center gap-1.5 text-[11px] font-700 text-muted hover:text-lamp border border-line px-3 py-1.5 hover:border-lamp transition">
							<i data-lucide="rotate-ccw" class="w-3 h-3"></i>
							Restaurar layout
						</button>
					</div>
				</div>

				<div class="flex flex-1 min-h-0 border-t border-line relative" x-ref="row" @pointerdown="panePointerDown($event)">

					<aside class="w-full flex-col bg-surface border-r border-line min-h-0 lg:flex"
						data-panel="files" :style="paneStyle('files')"
						:class="pane === 'files' ? 'flex' : 'hidden'">
						<div class="flex items-center gap-3 px-4 pt-3 pb-3 border-b border-line cursor-grab active:cursor-grabbing" data-drag-handle>
							<button type="button" @click="pane = 'chat'" class="lg:hidden grid place-items-center w-11 h-11 rounded-none border border-line text-muted hover:text-lamp" aria-label="Voltar ao chat"><i data-lucide="arrow-left" class="w-5 h-5"></i></button>
							<div class="flex-1 min-w-0">
							<div class="flex items-center gap-2 mb-3">
								<i data-lucide="grip-vertical" class="w-3.5 h-3.5 text-muted/40 shrink-0"></i>
								<i data-lucide="folder-tree" class="w-4 h-4 text-lamp shrink-0"></i>
								<span class="flex-1 truncate font-display font-800 text-cream">{ s.Config.Topic }</span>
							</div>
							<div x-data="{ open: false, kind: '' }" class="relative">
								<button type="button" @click="open = !open"
									class="w-full flex items-center justify-center gap-2 border border-line bg-surface2 text-sm font-700 text-cream/90 hover:border-lamp hover:text-lamp px-3 py-2 transition">
									<i data-lucide="plus" class="w-4 h-4"></i>
									Novo
									<i data-lucide="chevron-down" class="w-3.5 h-3.5 text-muted"></i>
								</button>
								<div x-show="open" @click.outside="open = false"
									class="absolute left-0 right-0 top-full mt-1 z-30 border border-line bg-surface2 shadow-hard p-1 text-sm">
									<button type="button" @click="kind = 'note'; open = false"
										class="w-full flex items-center gap-2 rounded-none px-2.5 py-2 text-cream/80 hover:bg-surface hover:text-cream transition">
										<i data-lucide="file-text" class="w-4 h-4 text-lamp/80"></i>
										Nova nota
									</button>
									<button type="button" @click="kind = 'folder'; open = false"
										class="w-full flex items-center gap-2 rounded-none px-2.5 py-2 text-cream/80 hover:bg-surface hover:text-cream transition">
										<i data-lucide="folder" class="w-4 h-4 text-lamp/80"></i>
										Nova pasta
									</button>
									<button type="button" @click="open = false; document.getElementById('ws-upload-input').click()"
										class="w-full flex items-center gap-2 rounded-none px-2.5 py-2 text-cream/80 hover:bg-surface hover:text-cream transition">
										<i data-lucide="image-plus" class="w-4 h-4 text-coral/80"></i>
										Enviar imagem
									</button>
								</div>
								<form x-show="kind !== ''" x-ref="createForm"
									hx-post={ studyBase(s.StudyID) + "/files" } hx-target="#file-tree" hx-swap="innerHTML"
									@htmx:after-request="kind = ''; $refs.createForm.reset()"
									class="mt-2 flex items-center gap-1">
									<input type="hidden" name="kind" :value="kind"/>
									<input type="text" name="name" autofocus
										:placeholder="kind === 'folder' ? 'Nome da pasta' : 'Nome da nota'"
										@keydown.enter="$el.form.requestSubmit()"
										class="input px-2.5 py-1.5 text-sm"/>
									<button type="submit" class="btn-primary px-2.5 py-1.5 text-xs">Criar</button>
								</form>
								<form hx-post={ studyBase(s.StudyID) + "/files/upload" } hx-target="#file-tree" hx-swap="innerHTML"
									hx-encoding="multipart/form-data" class="hidden">
									<input type="file" name="file" accept="image/png,image/jpeg,image/gif,image/webp"
										id="ws-upload-input" @change="$el.form.requestSubmit()"/>
								</form>
							</div>
							</div>
						</div>
					<div id="file-tree" class="flex-1 min-h-0 overflow-y-auto p-2"
						data-href={ studyBase(s.StudyID) + "/files" }
						hx-get={ studyBase(s.StudyID) + "/files" }
						hx-trigger="refreshFiles from:body"
						hx-swap="innerHTML">
						@FileTree(files, s.StudyID)
					</div>
					</aside>

					<div class="ws-handle hidden lg:flex items-center justify-center w-1.5 -mx-px shrink-0 relative group"
						:style="handleStyle(0)" @pointerdown="startResize(0, $event)" @pointermove="resizeMove($event)" @pointerup="resizeEnd()" @pointercancel="resizeEnd()" @dblclick="resetWidths()">
						<div class="ws-handle-line absolute inset-y-0 left-1/2 w-px -translate-x-1/2 bg-line"></div>
						<div class="relative z-10 flex flex-col gap-0.5 opacity-0 group-hover:opacity-100 transition-opacity">
							<span class="w-0.5 h-0.5 rounded-none bg-lamp/80"></span>
							<span class="w-0.5 h-0.5 rounded-none bg-lamp/80"></span>
							<span class="w-0.5 h-0.5 rounded-none bg-lamp/80"></span>
						</div>
					</div>

					<section class="min-w-0 flex-col min-h-0 bg-ink lg:flex"
						data-panel="editor" :style="paneStyle('editor')"
						:class="pane === 'editor' ? 'flex' : 'hidden'">
						<div id="main-pane" class="flex flex-col flex-1 min-h-0">
							<div class="flex-1 grid place-items-center p-8">
								<div class="text-center">
									<span class="grid place-items-center w-14 h-14 bg-surface2 border border-line mx-auto">
										<i data-lucide="notebook-pen" class="w-6 h-6 text-muted/50"></i>
									</span>
									<p class="mt-4 text-sm text-muted">Selecione ou crie uma nota</p>
								</div>
							</div>
						</div>
					</section>

					<div class="ws-handle hidden lg:flex items-center justify-center w-1.5 -mx-px shrink-0 relative group"
						:style="handleStyle(1)" @pointerdown="startResize(1, $event)" @pointermove="resizeMove($event)" @pointerup="resizeEnd()" @pointercancel="resizeEnd()" @dblclick="resetWidths()">
						<div class="ws-handle-line absolute inset-y-0 left-1/2 w-px -translate-x-1/2 bg-line"></div>
						<div class="relative z-10 flex flex-col gap-0.5 opacity-0 group-hover:opacity-100 transition-opacity">
							<span class="w-0.5 h-0.5 rounded-none bg-lamp/80"></span>
							<span class="w-0.5 h-0.5 rounded-none bg-lamp/80"></span>
							<span class="w-0.5 h-0.5 rounded-none bg-lamp/80"></span>
						</div>
					</div>

				@ChatPane(chats, active, msgs, s, state)

					<div x-ref="indicator" x-show="dropX !== null && drag !== null" x-cloak class="ws-drop-indicator" :style="'left:' + dropX + 'px'"></div>

				</div>
			</div>
		</div>
	}
}
