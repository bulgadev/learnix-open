package components

// SavedButton is the done-state pill swapped in over the "Salvar como nota"
// button after a message is saved as a note.
templ SavedButton() {
	<button type="button" disabled
		class="inline-flex items-center gap-1 border border-lamp bg-lamp/10 text-lamp text-[11px] font-600 px-2.5 py-1 cursor-default">
		<i data-lucide="check" class="w-3 h-3"></i>
		Nota criada
	</button>
}
