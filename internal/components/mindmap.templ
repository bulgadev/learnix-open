package components

import (
	"learnix/internal/db"
	"learnix/internal/mindmap"
)

func mindMapJSON(graph mindmap.Graph) string {
	b, _ := mindmap.Encode(graph)
	return string(b)
}

templ MindMapPage(topic string, studyID int64, graph mindmap.Graph, user *db.User, q *db.Quota, isAdmin bool, csrf string) {
	@Layout(studyPageData("Mapa mental", "study", topic, user, q, isAdmin, studyID, MobileStudyState{})) {
		<main class="max-w-[1500px] mx-auto px-4 sm:px-6 pb-24">
			<div class="flex flex-wrap items-center justify-between gap-4 py-5">
				<div class="min-w-0">
					<div class="flex items-center gap-2 text-xs text-muted mb-2">
						<a href={ studyBase(studyID) + "/workspace" } class="hover:text-lamp transition">Estudo</a>
						<i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
						<span class="text-lamp">Mapa mental</span>
					</div>
					<h1 class="font-display text-3xl sm:text-4xl font-800 tracking-tight">Mapa mental</h1>
					<p class="text-sm text-muted mt-1">Navegue pelo conteúdo, recolha ramos e ajuste o mapa enquanto estuda.</p>
				</div>
				<div class="flex items-center gap-2">
					<a href={ studyBase(studyID) + "/workspace" } class="btn-secondary px-3 py-2 text-sm font-800">
						<i data-lucide="arrow-left" class="w-4 h-4"></i> Voltar
					</a>
					<button type="button" data-map-save class="btn-primary px-3 py-2 text-sm">
						<i data-lucide="save" class="w-4 h-4"></i> Salvar
					</button>
				</div>
			</div>
			<div class="mb-4 flex items-start gap-3 border border-lamp bg-lamp/10 px-4 py-3 text-xs text-cream/80" role="status">
				<i data-lucide="flask-conical" class="mt-0.5 h-4 w-4 shrink-0 text-lamp"></i>
				<p><strong class="font-800 text-lamp">Recurso experimental.</strong> O mapa mental ainda está em desenvolvimento e pode mudar.</p>
			</div>

			<section id="mind-map-app" data-map-json={ mindMapJSON(graph) }
				data-map-update-url={ studyBase(studyID) + "/mapa-mental" }
				data-map-csrf={ csrf }
				class="grid lg:grid-cols-[minmax(0,1fr)_20rem] gap-4 ui-panel p-3 sm:p-4">
				<div class="min-h-[560px] border border-line bg-ink overflow-hidden" data-map-viewport tabindex="0" aria-label="Mapa mental interativo">
					<svg class="block w-full h-full min-h-[560px]" data-map-svg role="img" aria-label="Mapa mental"></svg>
				</div>
				<aside class="border border-line bg-surface2 p-4 flex flex-col min-h-[560px]">
					<div class="flex items-center justify-between gap-2">
						<h2 class="font-display text-xl font-800">Nó selecionado</h2>
						<span data-map-status class="text-[11px] text-muted">Pronto</span>
					</div>
					<div class="mt-4 space-y-3" data-map-inspector></div>
					<div class="mt-auto pt-4 border-t border-line space-y-2">
						<button type="button" data-map-add aria-label="Escolher pai para novo ramo" class="w-full inline-flex items-center justify-center gap-2 border border-lamp bg-lamp/10 px-3 py-2 text-sm font-800 text-lamp hover:bg-lamp/20 transition"><i data-lucide="plus" class="w-4 h-4"></i><span data-map-add-label>Adicionar ramo</span></button>
						<button type="button" data-map-remove class="w-full inline-flex items-center justify-center gap-2 border border-coral bg-coral/5 px-3 py-2 text-sm font-800 text-coral hover:bg-coral/10 transition"><i data-lucide="trash-2" class="w-4 h-4"></i>Remover subárvore</button>
						<p class="text-[11px] leading-relaxed text-muted">Arraste o fundo para navegar. Use a roda ou os botões para zoom. Clique em um nó para editar. Para criar um ramo, escolha explicitamente o nó pai.</p>
					</div>
				</aside>
			</section>
		</main>
	}
}
