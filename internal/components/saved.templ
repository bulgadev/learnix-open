package components

import (
	"strings"

	"learnix/internal/db"
)

func excerptSnippet(s string, n int) string {
	one := strings.Join(strings.Fields(s), " ")
	if r := []rune(one); len(r) > n {
		return string(r[:n]) + "…"
	}
	return one
}

// BookmarkButton toggles the saved state of a chat message.
templ BookmarkButton(studyID int64, m db.ChatMessage) {
	<button type="button"
		hx-post={ studyBase(studyID) + "/chats/" + idStr(m.ChatID) + "/messages/" + idStr(m.ID) + "/save" }
		hx-target="this" hx-swap="outerHTML"
		class={ "inline-flex items-center gap-1 border text-[11px] font-600 px-2.5 py-1 transition",
			templ.KV("border-lamp bg-lamp/10 text-lamp", m.Saved),
			templ.KV("border-line bg-surface2 text-muted hover:text-lamp hover:border-lamp", !m.Saved) }>
		<i data-lucide="bookmark" class="w-3 h-3"></i>
		if m.Saved {
			Salvo
		} else {
			Salvar resposta
		}
	</button>
}

templ SavedPanel(studyID int64, highlights []db.Highlight, saved []db.ChatMessage, chatOf map[int64]string) {
	{{ base := studyBase(studyID) }}
	if len(highlights) == 0 && len(saved) == 0 {
		<div class="px-4 py-10 text-center">
			<span class="grid place-items-center w-12 h-12 mx-auto rounded-none bg-surface2 text-muted mb-3">
				<i data-lucide="highlighter" class="w-6 h-6"></i>
			</span>
			<p class="text-sm font-600 text-cream/80">Nada salvo ainda.</p>
			<p class="text-xs text-muted mt-1">Selecione texto numa nota ou resposta para destacar, ou marque respostas com o bookmark.</p>
		</div>
	} else {
		if len(highlights) > 0 {
			<div class="px-4 pt-4">
				<p class="flex items-center gap-1.5 text-[11px] font-800 uppercase tracking-[0.15em] text-lamp mb-3">
					<i data-lucide="highlighter" class="w-3.5 h-3.5"></i>
					Destaques
				</p>
				<div class="space-y-3">
					for _, hl := range highlights {
						<div class="border border-line bg-ink px-4 py-3">
							<p class="text-sm text-cream/90 leading-relaxed border-l-2 border-lamp/60 pl-3">{ excerptSnippet(hl.Excerpt, 280) }</p>
							if hl.Note != "" {
								<p class="text-xs text-muted mt-2 pl-3">{ hl.Note }</p>
							}
							<div class="flex items-center justify-between mt-2.5 pl-3">
								<span class="text-[10px] font-700 uppercase tracking-wide text-muted/70">
									if hl.SourceKind == "note" {
										Nota
									} else {
										Conversa
									}
								</span>
								<button type="button" hx-post={ base + "/highlights/" + idStr(hl.ID) + "/delete" }
									hx-target="#saved-drawer" hx-swap="innerHTML"
									class="text-[11px] font-600 text-muted/70 hover:text-coral transition">
									Remover
								</button>
							</div>
						</div>
					}
				</div>
			</div>
		}
		if len(saved) > 0 {
			<div class="px-4 pt-5 pb-4">
				<p class="flex items-center gap-1.5 text-[11px] font-800 uppercase tracking-[0.15em] text-lamp mb-3">
					<i data-lucide="bookmark" class="w-3.5 h-3.5"></i>
					Respostas salvas
				</p>
				<div class="space-y-3">
					for _, m := range saved {
						<div class="border border-line bg-ink px-4 py-3">
							<p class="text-xs text-muted/80 leading-relaxed">{ excerptSnippet(m.Content, 160) }</p>
							<div class="flex items-center justify-between mt-2.5">
								<span class="text-[10px] font-700 uppercase tracking-wide text-muted/70 truncate">{ chatOf[m.ChatID] }</span>
								<a href={ "#msg-" + idStr(m.ID) }
									class="text-[11px] font-600 text-lamp hover:underline">Ir para</a>
							</div>
						</div>
					}
				</div>
			</div>
		}
	}
}
